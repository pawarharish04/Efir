# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Replace with your own credentials or local MongoDB URI)
# Local: mongodb://localhost:27017/efir_portal
# Atlas: mongodb+srv://<username>:<password>@cluster.example.mongodb.net/efir_portal?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/efir_portal

# JWT Authentication Secret (Use a strong random key, min 32 characters)
JWT_SECRET=replace_with_a_secure_random_secret_key_here

# Frontend Application URL for CORS
FRONTEND_URL=http://localhost:5173

# Optional: Email Service Credentials
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password
